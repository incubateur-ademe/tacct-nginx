{
	admin off
	servers {
		# Chemin d'une requête : visiteur -> Cloudflare -> routeur Scalingo -> Caddy.
		# Cloudflare puis le routeur Scalingo ajoutent chacun, à droite de
		# X-Forwarded-For, l'IP qui les contacte : "IP du visiteur, IP Cloudflare".
		# En mode strict, Caddy lit l'en-tête de droite à gauche, saute les proxys
		# de confiance (réseau privé Scalingo, Cloudflare) et met la première autre
		# IP dans {client_ip} : celle du visiteur. Une IP ajoutée à gauche par le
		# visiteur lui-même est ignorée.
		# Plages Cloudflare : https://www.cloudflare.com/ips/ (à mettre à jour si elles changent).
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
	}
}

:{$PORT} {
	log

	route {
		rate_limit {
			zone par_ip {
				# Pas {remote_host} : c'est l'IP du routeur Scalingo, commune à tous les visiteurs.
				key {client_ip}
				events 40
				window 1s
			}
		}

		coraza_waf {
			load_owasp_crs
			# load_owasp_crs rend seulement les fichiers @... disponibles :
			# il faut inclure la CRS explicitement.
			# crs-setup.conf (réglages de la CRS) doit rester AVANT la CRS.
			# secrules.conf (exclusions) doit rester APRES la CRS, sinon
			# SecRuleRemoveById ne trouve pas encore les règles à retirer.
			# SecDebugLogLevel 1 : le journal de débogage de Coraza ne garde que les
			# erreurs (sinon ~3 avertissements "key not found in collection" par
			# requête). Les règles déclenchées restent journalisées.
			directives `
				Include @coraza.conf-recommended
				Include @crs-setup.conf.example
				Include crs-setup.conf
				Include @owasp_crs/*.conf
				SecRuleEngine On
				SecResponseBodyAccess Off
				SecDebugLogLevel 1
				Include secrules.conf
			`
		}

		# Compresse les réponses (sans effet si l'app les compresse déjà).
		encode zstd gzip

		reverse_proxy {$PRODUCTION_SITE} {
			header_up Host {http.reverse_proxy.upstream.host}
			header_down Location ^{$PRODUCTION_SITE} ""
		}
	}
}
